{
  "name": "navbook-workspace",
  "version": "0.2.0",
  "private": true,
  "description": "Workspace root for @navbook/core and @navbook/cli",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && pnpm typecheck",
    "test": "pnpm -r test && pnpm test:conformance",
    "test:conformance": "node --test \"test/conformance/**/*.test.ts\"",
    "bench": "pnpm --filter @navbook/cli bench"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "yaml": "^2.8.4"
  }
}
