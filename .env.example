# Navbook, deployed with Docker Compose.
#
# Copy this file to `.env` — git ignores that one — and edit it:
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Every key is listed, with the value it takes when you leave it alone. The ones
# marked "required" name your deployment and have no sensible default; Compose
# refuses to start without them and says which one is missing.
#
# None of it is baked into an image. Both containers read their configuration
# when they start, so changing a value here is an edit and a restart.


# ---------------------------------------------------------------------------
# Where it answers
# ---------------------------------------------------------------------------
#
# Two hostnames, because the client and the API are two containers. They need
# not share a domain: the API answers any origin that brings an `Authorization`
# header, so nothing here depends on CORS.

# required — the hostname the web client is served on.
NAVBOOK_WEB_HOST=navbook.example.com

# required — the hostname the GraphQL API is served on.
NAVBOOK_API_HOST=api.navbook.example.com

# The address the browser sends GraphQL to. Empty derives it from the API host
# above, which is what you want unless something else sits in front.
NAVBOOK_GRAPHQL_URL=


# ---------------------------------------------------------------------------
# Who is asking
# ---------------------------------------------------------------------------
#
# The API answers nothing without a token, so an identity provider is not
# optional. It has to mint JWT access tokens carrying this audience and an
# `email` claim, and issue refresh tokens; see packages/web/README.md.

# required — the provider's OpenID discovery document. It names the issuer
# tokens must carry and where the keys are, so it is the one address both
# containers need; for most providers it is `<issuer>/.well-known/openid-
# configuration`, but a provider whose issuer carries a path may publish it
# at the host root instead, which is why the document is named and not the
# issuer.
NAVBOOK_OIDC_DISCOVERY_URL=https://accounts.example.com/.well-known/openid-configuration

# required — the `aud` claim tokens must carry. The client asks for it and the
# server checks it, so both containers are told the same value. It is sent as
# `resource` too, so a provider implementing RFC 8707 has to list it as a valid
# audience (Better Auth: `validAudiences`).
NAVBOOK_OIDC_AUDIENCE=navbook

# required — the client the browser signs in as, registered with the issuer as
# a public client with NAVBOOK_WEB_HOST as a redirect URI.
NAVBOOK_OIDC_CLIENT_ID=navbook-web

# Who, among the people the provider vouches for, is allowed in. Empty, all
# three together mean anyone the provider signs a token for may read and
# write — which, against a provider shared with other projects, is everybody
# it knows; the server says so in its log at start. Every rule given has to
# hold. Claims are `name=value`, comma-separated: the claim must equal the
# value, or carry it when it is an array or a space-separated string (`scope`,
# Better Auth's `roles`). Domains are the part after the `@` of the `email`
# claim, comma-separated. `true` refuses a token whose `email_verified` is not.
NAVBOOK_REQUIRE_CLAIMS=
NAVBOOK_ALLOW_EMAIL_DOMAINS=
NAVBOOK_REQUIRE_EMAIL_VERIFIED=


# ---------------------------------------------------------------------------
# The repository being served
# ---------------------------------------------------------------------------
#
# The API works against a clone it makes itself, in a named volume, and keeps in
# step with this remote. That volume is not a database: it can be thrown away
# and made again, and the next start does exactly that.

# required — the repository to clone. HTTPS, since that is what the credentials
# below are for.
NAVBOOK_REPO_URL=https://github.com/an-org/a-project.git

# The branch to serve. Empty follows the remote's default branch.
NAVBOOK_BRANCH=

# The Navbook directory, when the repository does not use `.navbook/`. Empty is
# right for every repository that does.
NAVBOOK_ROOT=

# required — who the commits are *by*. The person a commit is *for* comes from
# their token, and is recorded as `author:`.
NAVBOOK_GIT_NAME=Navbook
NAVBOOK_GIT_EMAIL=navbook@example.com

# How the clone authenticates to push. Empty means no credentials are offered,
# which serves a public repository read-only and fails every mutation. Use a
# token scoped to this one repository: on GitHub a fine-grained token with
# Contents: read and write, whose username is `x-access-token`.
NAVBOOK_GIT_USERNAME=x-access-token
NAVBOOK_GIT_TOKEN=

# The remote to synchronise with, and how stale a read may let its view of it
# become. A mutation always fetches first, whatever this says.
NAVBOOK_REMOTE=origin
NAVBOOK_PULL_INTERVAL_MS=10000

# How long any one fetch or push may take before the server stops it and fails
# that request alone, rather than holding every request queued behind it. 0
# waits as long as git does.
NAVBOOK_GIT_TIMEOUT_MS=30000

# Whether to serve the GraphiQL explorer. It answers nothing without a token,
# but its page is static HTML anyone who can reach the API host can load.
NAVBOOK_GRAPHIQL=false


# ---------------------------------------------------------------------------
# The Traefik in front
# ---------------------------------------------------------------------------
#
# Assumed to be running already, with the Docker provider watching the network
# named here. Nothing about Traefik itself is configured from this project.

# The external Docker network both containers join to be routed. Create it once
# with `docker network create traefik` if it does not exist yet.
NAVBOOK_TRAEFIK_NETWORK=traefik

# The entrypoint the routers listen on, and the certificate resolver they ask
# for TLS. Both are names defined in your Traefik's own configuration.
NAVBOOK_TRAEFIK_ENTRYPOINT=websecure
NAVBOOK_TRAEFIK_CERTRESOLVER=letsencrypt


# ---------------------------------------------------------------------------
# The images
# ---------------------------------------------------------------------------

# The tag the two images are built and run as. Nothing is published to a
# registry: `docker compose up --build` builds them from this checkout.
NAVBOOK_IMAGE_TAG=local
