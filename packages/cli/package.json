{
  "name": "@navbook/cli",
  "version": "0.6.1",
  "description": "Git-native issue and pull-request tracking as plaintext files in your repository",
  "keywords": [
    "issues",
    "tracker",
    "git",
    "pull-request",
    "offline",
    "markdown"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peyremorgan/navbook.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/peyremorgan/navbook#readme",
  "bugs": "https://github.com/peyremorgan/navbook/issues",
  "type": "module",
  "exports": {
    "./plugin": "./src/plugins/host.ts",
    "./test-helpers": "./test/helpers/temprepo.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./plugin": {
        "types": "./dist/plugins/host.d.ts",
        "default": "./dist/plugins/host.js"
      }
    }
  },
  "bin": {
    "nav": "dist/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/cli/**/*.test.ts\"",
    "bench": "node --test \"test/perf/**/*.test.ts\"",
    "prepack": "node ../../script/require-pnpm.js && pnpm build",
    "prepublishOnly": "node ../../script/require-pnpm.js"
  },
  "dependencies": {
    "@navbook/core": "workspace:*",
    "commander": "^14.0.2",
    "picocolors": "^1.1.1",
    "string-width": "^8.2.2"
  }
}
