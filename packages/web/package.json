{
  "name": "@navbook/web",
  "version": "0.2.0",
  "private": true,
  "description": "Web UI for Navbook: a thin client of the @navbook/server GraphQL API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxi dev",
    "dev:stack": "node script/dev-stack.ts",
    "dev:issuer": "node script/dev-issuer.ts",
    "build": "nuxi generate",
    "postinstall": "nuxi prepare",
    "typecheck": "nuxi typecheck && tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config test-e2e/playwright.config.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts && git diff --exit-code -- src/generated"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@nuxt/ui": "^4.11.0",
    "@vue/apollo-composable": "^4.2.2",
    "dompurify": "^3.4.14",
    "graphql": "^16.14.2",
    "markdown-it": "^15.0.1",
    "nuxt": "^4.5.2",
    "oidc-client-ts": "^3.5.0",
    "vue": "^3.5.40",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@navbook/core": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.1.2",
    "@vue/test-utils": "^2.4.6",
    "jose": "^6.2.10",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
