{
  "name": "@navbook/plugin-discord",
  "version": "0.7.0",
  "description": "A Discord bridge for the tracker: a thread per pull request and per issue you choose, updates and mentions in it, and commands that comment, review, assign and close as the person who typed them",
  "keywords": [
    "navbook-plugin",
    "issues",
    "tracker",
    "git",
    "discord",
    "chat",
    "bot"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peyremorgan/navbook.git",
    "directory": "packages/plugin-discord"
  },
  "homepage": "https://github.com/peyremorgan/navbook#readme",
  "bugs": "https://github.com/peyremorgan/navbook/issues",
  "type": "module",
  "engines": {
    "node": ">=24",
    "navbook": "^1.2.0"
  },
  "exports": {
    "./core": "./src/core/index.ts",
    "./cli": "./src/cli/index.ts",
    "./server": "./src/server/index.ts",
    "./web": "./web/nuxt.config.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./core": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "./cli": {
        "types": "./dist/cli/index.d.ts",
        "default": "./dist/cli/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "./web": "./web/nuxt.config.ts",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "doc",
    "schema.graphql",
    "web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepack": "node ../../script/require-pnpm.js && pnpm build",
    "prepublishOnly": "node ../../script/require-pnpm.js",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts && git diff --exit-code -- web/src/generated"
  },
  "peerDependencies": {
    "@navbook/core": "^0.7.0",
    "@apollo/client": "^3.14.1",
    "@vue/apollo-composable": "^4.2.2",
    "graphql": "^16.14.2",
    "vue": "^3.5.40"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "@vue/apollo-composable": {
      "optional": true
    },
    "graphql": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apollo/client": "^3.14.1",
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@navbook/cli": "workspace:*",
    "@navbook/core": "workspace:*",
    "@navbook/server": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@vue/apollo-composable": "^4.2.2",
    "graphql": "^16.14.2",
    "vue": "^3.5.40"
  },
  "navbook": {
    "short": "discord",
    "spec": "doc/spec.md",
    "core": {
      "doctorChecks": [
        {
          "id": "X-discord-1",
          "level": "error",
          "description": "the plugin's settings in navbook.json: its guild, channels, rules and people"
        }
      ],
      "commitScopes": [
        "discord"
      ]
    },
    "cli": {
      "commands": [
        {
          "name": "discord",
          "description": "the Discord bridge's links between Discord accounts and people",
          "commands": [
            {
              "name": "link",
              "description": "record that a Discord account acts as this address",
              "arguments": [
                {
                  "name": "discord-user-id",
                  "description": "the account's user id, as Developer Mode copies it"
                },
                {
                  "name": "email",
                  "description": "the address its actions are recorded under"
                }
              ],
              "options": [
                {
                  "flags": "--commit",
                  "description": "wrap the change in a 'docs(discord):' commit"
                }
              ]
            },
            {
              "name": "unlink",
              "description": "forget a link, by Discord user id or by address",
              "arguments": [
                {
                  "name": "id-or-email",
                  "description": "a Discord user id, or an address to forget every link of"
                }
              ],
              "options": [
                {
                  "flags": "--commit",
                  "description": "wrap the change in a 'docs(discord):' commit"
                }
              ]
            },
            {
              "name": "people",
              "description": "list the linked Discord accounts",
              "options": [
                {
                  "flags": "--json",
                  "description": "one JSON object per link, newline-delimited"
                }
              ]
            }
          ]
        }
      ]
    },
    "server": {
      "schema": "schema.graphql",
      "services": true,
      "config": [
        {
          "env": "NAV_SERVER_DISCORD_TOKEN",
          "description": "the bot's token; without it the bridge is not offered"
        },
        {
          "env": "NAV_SERVER_DISCORD_GUILD",
          "description": "the one Discord server the bridge may serve; settings naming another are refused"
        },
        {
          "env": "NAV_SERVER_DISCORD_TRUST_LINKS",
          "description": "true: linked accounts act although the server requires claims or a verified address, which Discord cannot show"
        },
        {
          "env": "NAV_SERVER_DISCORD_API_URL",
          "description": "Discord's API, when it is not https://discord.com/api/v10"
        }
      ]
    },
    "web": true
  }
}
