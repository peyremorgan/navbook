{
  "name": "@navbook/plugin-chat",
  "version": "0.6.0",
  "description": "An assistant for the tracker: ask about issues and pull requests in your own words, and have it file, comment, review, open and close them — after you approve each change",
  "keywords": [
    "navbook-plugin",
    "issues",
    "tracker",
    "git",
    "assistant",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peyremorgan/navbook.git",
    "directory": "packages/plugin-chat"
  },
  "homepage": "https://github.com/peyremorgan/navbook#readme",
  "bugs": "https://github.com/peyremorgan/navbook/issues",
  "type": "module",
  "engines": {
    "node": ">=24",
    "navbook": "^1.1.0"
  },
  "exports": {
    "./cli": "./src/cli/index.ts",
    "./server": "./src/server/index.ts",
    "./web": "./web/nuxt.config.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./cli": {
        "types": "./dist/cli/index.d.ts",
        "default": "./dist/cli/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "./web": "./web/nuxt.config.ts",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "doc",
    "schema.graphql",
    "src/shared/sse.ts",
    "web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepack": "node ../../script/require-pnpm.js && pnpm build",
    "prepublishOnly": "node ../../script/require-pnpm.js",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts && git diff --exit-code -- web/src/generated"
  },
  "peerDependencies": {
    "@navbook/core": "^0.6.0",
    "@apollo/client": "^3.14.1",
    "@vue/apollo-composable": "^4.2.2",
    "graphql": "^16.14.2",
    "vue": "^3.5.40"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "@vue/apollo-composable": {
      "optional": true
    },
    "graphql": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apollo/client": "^3.14.1",
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@navbook/cli": "workspace:*",
    "@navbook/core": "workspace:*",
    "@navbook/server": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@vue/apollo-composable": "^4.2.2",
    "graphql": "^16.14.2",
    "vue": "^3.5.40"
  },
  "navbook": {
    "short": "chat",
    "cli": {
      "commands": [
        {
          "name": "chat",
          "description": "talk to an assistant about this tracker; it calls the model endpoint you configure",
          "options": [
            {
              "flags": "-m, --message <text>",
              "description": "ask one thing and print the answer; without it a conversation starts"
            },
            {
              "flags": "-y, --yes",
              "description": "apply the changes the assistant proposes without asking"
            },
            {
              "flags": "--model <id>",
              "description": "the model to use (default: NAV_CHAT_MODEL, then navbook.json)"
            },
            {
              "flags": "--json",
              "description": "one JSON event per line, for scripts; changes need -y"
            }
          ]
        }
      ]
    },
    "server": {
      "schema": "schema.graphql",
      "config": [
        {
          "env": "NAV_SERVER_CHAT_API_KEY",
          "description": "the key for the model endpoint, sent as a bearer token; not needed by a local server"
        },
        {
          "env": "NAV_SERVER_CHAT_BASE_URL",
          "description": "the OpenAI-compatible endpoint, e.g. https://api.openai.com/v1 (default) or http://localhost:11434/v1"
        },
        {
          "env": "NAV_SERVER_CHAT_MODEL",
          "description": "the model to use; the plugin's navbook.json settings otherwise"
        }
      ]
    },
    "web": true
  }
}
