{
  "name": "@navbook/plugin-tests",
  "version": "0.5.0",
  "description": "Manual test plans under tests/, and the runs that record executing one: standalone, or attached to a pull request",
  "keywords": [
    "navbook-plugin",
    "issues",
    "tracker",
    "git",
    "testing",
    "test-plans"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peyremorgan/navbook.git",
    "directory": "packages/plugin-tests"
  },
  "homepage": "https://github.com/peyremorgan/navbook#readme",
  "bugs": "https://github.com/peyremorgan/navbook/issues",
  "type": "module",
  "engines": {
    "node": ">=24",
    "navbook": "^1.1.0"
  },
  "exports": {
    "./core": "./src/core/index.ts",
    "./cli": "./src/cli/index.ts",
    "./server": "./src/server/index.ts",
    "./web": "./web/nuxt.config.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./core": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "./cli": {
        "types": "./dist/cli/index.d.ts",
        "default": "./dist/cli/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "./web": "./web/nuxt.config.ts",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "doc",
    "schema.graphql",
    "web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepack": "node ../../script/require-pnpm.js && pnpm build",
    "prepublishOnly": "node ../../script/require-pnpm.js",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts && git diff --exit-code -- web/src/generated"
  },
  "peerDependencies": {
    "@navbook/core": "^0.5.0",
    "@apollo/client": "^3.14.1",
    "@vue/apollo-composable": "^4.2.2",
    "graphql": "^16.14.2",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@apollo/client": "^3.14.1",
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@navbook/cli": "workspace:*",
    "@navbook/core": "workspace:*",
    "@navbook/server": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@vue/apollo-composable": "^4.2.2",
    "graphql": "^16.14.2",
    "vue": "^3.5.40"
  },
  "navbook": {
    "short": "tests",
    "spec": "doc/spec.md",
    "format": {
      "root": [
        "tests"
      ],
      "entityDirs": [
        "tests"
      ]
    },
    "core": {
      "queryKeys": [
        {
          "key": "tested",
          "kinds": [
            "pr"
          ],
          "help": "tested:STATE                 the latest run on the latest revision: passed, failed, blocked, skipped, incomplete, in-progress or none (repeatable, ORs)"
        }
      ],
      "doctorChecks": [
        {
          "id": "X-tests-1",
          "level": "error",
          "description": "the layout of tests/, and the schema of every plan and run, pull requests' included"
        },
        {
          "id": "X-tests-2",
          "level": "warning",
          "description": "a run naming a plan, plan version or commit this tree or repository does not hold"
        },
        {
          "id": "X-tests-3",
          "level": "error",
          "description": "a run ID that is also another run's, an entity's or a comment's"
        }
      ],
      "commitScopes": [
        "tests"
      ]
    },
    "cli": {
      "commands": [
        {
          "name": "test",
          "description": "work with test plans and their runs",
          "commands": [
            {
              "name": "open",
              "description": "create a test plan",
              "arguments": [
                {
                  "name": "title",
                  "description": "one-line name for the plan"
                }
              ],
              "options": [
                {
                  "flags": "-m, --message <text>",
                  "description": "the plan's description and steps; without it $EDITOR is opened on a skeleton"
                },
                {
                  "flags": "--slug <slug>",
                  "description": "directory name to file it under; derived from the title otherwise"
                },
                {
                  "flags": "--commit",
                  "description": "wrap the change in a 'docs(tests):' commit"
                }
              ]
            },
            {
              "name": "list",
              "description": "list test plans, with their runs' latest outcome",
              "arguments": [
                {
                  "name": "words",
                  "description": "words the slug or title must contain",
                  "optional": true,
                  "variadic": true
                }
              ],
              "options": [
                {
                  "flags": "--json",
                  "description": "one JSON object per plan, newline-delimited"
                }
              ]
            },
            {
              "name": "show",
              "description": "render a plan and its recent runs, or one run beside its plan's steps",
              "arguments": [
                {
                  "name": "ref",
                  "description": "a plan's slug, or a run's ID",
                  "complete": "plan-or-run"
                }
              ],
              "options": [
                {
                  "flags": "--runs <n>",
                  "description": "recent runs to list with a plan (default 5)",
                  "parse": "int"
                },
                {
                  "flags": "--json",
                  "description": "emit a single JSON object"
                }
              ]
            },
            {
              "name": "edit",
              "description": "open a plan's plan.md in $EDITOR",
              "arguments": [
                {
                  "name": "slug",
                  "description": "the plan's directory name",
                  "complete": "plan"
                }
              ],
              "options": [
                {
                  "flags": "--commit",
                  "description": "wrap the change in a 'docs(tests):' commit"
                }
              ]
            },
            {
              "name": "run",
              "description": "start a run of a plan, and walk through its steps",
              "arguments": [
                {
                  "name": "slug",
                  "description": "the plan to run",
                  "complete": "plan"
                }
              ],
              "options": [
                {
                  "flags": "--pr <id>",
                  "description": "attach the run to a pull request, writing it in its directory"
                },
                {
                  "flags": "--at <rev>",
                  "description": "the commit tested (default: the pull request's latest revision, else HEAD unless --version is given)"
                },
                {
                  "flags": "--version <name>",
                  "description": "the version tested, by name: a release, a build"
                },
                {
                  "flags": "--env <text>",
                  "description": "where it was tested"
                },
                {
                  "flags": "--interactive",
                  "description": "walk through the steps even without a terminal, reading answers from stdin"
                },
                {
                  "flags": "--no-interactive",
                  "description": "only start the run; record its steps with 'nav test record'"
                },
                {
                  "flags": "--commit",
                  "description": "wrap the change in a 'docs(tests):' commit"
                }
              ]
            },
            {
              "name": "record",
              "description": "record one step of a run",
              "arguments": [
                {
                  "name": "run",
                  "description": "the run's ID, or an unambiguous prefix of it",
                  "complete": "run"
                },
                {
                  "name": "step",
                  "description": "the step's number in the plan"
                },
                {
                  "name": "status",
                  "description": "passed, failed, blocked or skipped",
                  "complete": "status"
                }
              ],
              "options": [
                {
                  "flags": "-m, --actual <text>",
                  "description": "what was observed"
                },
                {
                  "flags": "--commit",
                  "description": "wrap the change in a 'docs(tests):' commit"
                }
              ]
            },
            {
              "name": "resume",
              "description": "walk through a run's unrecorded steps",
              "arguments": [
                {
                  "name": "run",
                  "description": "the run's ID, or an unambiguous prefix of it",
                  "complete": "run"
                }
              ],
              "options": [
                {
                  "flags": "--commit",
                  "description": "wrap the change in a 'docs(tests):' commit"
                }
              ]
            },
            {
              "name": "finish",
              "description": "say a run is done; its unrecorded steps stay not run",
              "arguments": [
                {
                  "name": "run",
                  "description": "the run's ID, or an unambiguous prefix of it",
                  "complete": "run"
                }
              ],
              "options": [
                {
                  "flags": "--commit",
                  "description": "wrap the change in a 'docs(tests):' commit"
                }
              ]
            },
            {
              "name": "runs",
              "description": "list runs, newest first",
              "arguments": [
                {
                  "name": "terms",
                  "description": "a plan's slug, or plan:SLUG, pr:ID, outcome:STATE",
                  "optional": true,
                  "variadic": true,
                  "complete": "runs-term"
                }
              ],
              "options": [
                {
                  "flags": "--all-refs",
                  "description": "include runs in pull requests on other fetched branches"
                },
                {
                  "flags": "--json",
                  "description": "one JSON object per run, newline-delimited"
                }
              ]
            },
            {
              "name": "attach",
              "description": "attach files to a run, and link them from it",
              "arguments": [
                {
                  "name": "run",
                  "description": "the run's ID, or an unambiguous prefix of it",
                  "complete": "run"
                },
                {
                  "name": "files",
                  "description": "the files to copy beside the run",
                  "variadic": true
                }
              ],
              "options": [
                {
                  "flags": "--step <n>",
                  "description": "link them under this recorded step's actual result, rather than in the notes",
                  "parse": "int"
                },
                {
                  "flags": "--commit",
                  "description": "wrap the change in a 'docs(tests):' commit"
                }
              ]
            }
          ]
        }
      ],
      "contributions": [
        {
          "on": "pr show",
          "showSection": true,
          "jsonExtra": true
        },
        {
          "on": "pr list",
          "completions": true
        }
      ]
    },
    "server": {
      "schema": "schema.graphql"
    },
    "web": true
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    },
    "@vue/apollo-composable": {
      "optional": true
    },
    "graphql": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
